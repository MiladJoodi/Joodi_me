# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js / build
.next/
**/.next/
/out/
/build
dist/
**/dist/

# testing
/coverage

# misc / OS
.DS_Store
Thumbs.db
desktop.ini
*.pem
*.bak
*.tmp
*.local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env (opt-in if you need a committed example via !.env.example)
.env*

# vercel / turbo
.vercel
.turbo

# typescript
*.tsbuildinfo
next-env.d.ts

# UI source of truth is packages/ui → public/r (do not reintroduce hand-edited copies)
/registry/ui/
