{
  "name": "@winkui/ui",
  "version": "1.0.1",
  "description": "WinkUI — design system + CLI (copy-source add)",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "winkui": "./bin/winkui-ui.mjs"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "cli",
    "bin",
    "README.md"
  ],
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./lib/*": "./src/lib/*.ts",
    "./lib/direction": "./src/lib/direction.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*",
    "./hooks/use-direction": "./src/hooks/use-direction.tsx"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.5.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.474.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.7.0",
    "react-hook-form": "^7.62.0",
    "react-resizable-panels": "^4",
    "recharts": "^3.8.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
